# Copy to ../.env (repo root) and fill. Never commit .env
LLM_PROVIDER=gemini
ANSWER_MODEL=<flash model name from AI Studio>
VISION_MODEL=<flash-lite model name from AI Studio>
LLM_FALLBACK_CHAIN=<flash>,<flash-lite>,ollama
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434
LLM_DAILY_CAP=0            # 0 = use limits shown in AI Studio; set a number to self-cap per model
DATABASE_URL=postgresql://pause:pause@localhost:5432/pause
DATA_DIR=./data
JWT_SECRET=change-me
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TESSERACT_CMD=tesseract
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
EMBED_MODEL=intfloat/multilingual-e5-small
RERANK_ENABLED=false
TOPK=8
CONTEXT_TOKEN_CAP=3500
RECENT_WINDOW_S=60
RECENT_WINDOW_WIDE_S=180
RECENT_MIN_WORDS=20
REFUSAL_SCORE_THRESHOLD=
ALIGN_TAU=
VISION_CALLS_PER_VIDEO_CAP=100
MAX_VIDEO_HOURS=3
MAX_UPLOAD_MB=2048
RATE_LIMIT_PER_MIN=30
YT_COOKIES_FILE=
INTERVIEW_MAX_MINUTES=10
INTERVIEW_MAX_TURNS=8
INTERVIEW_WEIGHTS=technical:0.4,communication:0.2,problem_solving:0.25,structure:0.15
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0
